  {
    "name": "relocation",
    "messages": [
      {
        "role": "user",
        "content": "one"
      },
      {
        "role": "assistant",
        "content": "two"
      },
      {
        "role": "user",
        "content": "three <@1>insert</@1>"
      }
    ],
    "config": {},
    "expected": [
      {
        "role": "assistant",
        "content": "Sophia: one\n\nGray: two\n\ninsert\n\nSophia: three"
      }
    ]
  },
  {
    "name": "separator",
    "messages": [
      {
        "role": "system",
        "content": "system [END] context"
      },
      {
        "role": "user",
        "content": "Hi"
      }
    ],
    "config": {
      "separator": "\\n---\\n",
      "separator_system": "[END]"
    },
    "expected": [
      {
        "role": "system",
        "content": "system [END]"
      },
      {
        "role": "assistant",
        "content": " context\n\n---\n\nSophia: Hi"
      }
    ]
  },
  {
    "name": "protected-system",
    "messages": [
      {
        "role": "system",
        "content": "<|no-trans|>system [END] remaining"
      },
      {
        "role": "user",
        "content": "hello"
      }
    ],
    "config": {
      "separator_system": "[END]"
    },
    "expected": [
      {
        "role": "system",
        "content": "system [END]"
      },
      {
        "role": "system",
        "content": "remaining"
      },
      {
        "role": "assistant",
        "content": "Sophia: hello"
      }
    ]
  }
]
