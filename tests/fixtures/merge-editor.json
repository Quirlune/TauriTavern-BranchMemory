      {
        "role": "user",
        "content": "two"
      },
      {
        "role": "assistant",
        "content": "three <|Merge Disable|>"
      }
    ],
    "config": {},
    "expected": [
      {
        "role": "assistant",
        "content": "Sophia: one\n\nSophia: two\n\nGray: three"
      }
    ]
  },
  {
    "name": "whitespace",
    "messages": [
      {
        "role": "user",
        "content": "A <|join|> B <|space|> C <|curtail|> D"
      }
    ],
    "config": {},
    "expected": [
      {
        "role": "assistant",
        "content": "Sophia: AB C\nD"
      }
    ]
  },
  {
    "name": "regex",
    "messages": [
      {
        "role": "user",
        "content": "cat <regex>\"/cat/g\":\"dog\"</regex>"
      }
    ],
    "config": {},
    "expected": [
      {
        "role": "assistant",
        "content": "Sophia: dog"
      }
    ]
  },
  {
