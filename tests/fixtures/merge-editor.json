  },
  {
    "name": "adjacent",
    "messages": [
      {
        "role": "user",
        "content": "one"
      },
      {
        "role": "user",
        "content": "two"
      },
      {
        "role": "assistant",
        "content": "three"
      },
      {
        "role": "assistant",
        "content": "four"
      }
    ],
    "config": {},
    "expected": [
      {
        "role": "assistant",
        "content": "Sophia: one\n\ntwo\n\nGray: three\n\nfour"
      }
    ]
  },
  {
    "name": "flags",
    "messages": [
      {
        "role": "user",
        "content": "one <|Merge Human Disable|>"
